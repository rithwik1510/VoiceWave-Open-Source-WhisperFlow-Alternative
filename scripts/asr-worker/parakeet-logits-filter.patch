VoiceWave patch for whisper.cpp 1.9.5 (plan 021): a logits filter hook in the
Parakeet greedy decoder, so the speech worker can boost dictionary terms.
Applied by src-tauri/windows/asr-worker/CMakeLists.txt; re-check at each
whisper.cpp bump.

diff --git a/include/parakeet.h b/include/parakeet.h
--- a/include/parakeet.h
+++ b/include/parakeet.h
@@ -231,6 +231,16 @@ extern "C" {
     // If it returns false, the computation is aborted
     typedef bool (*parakeet_encoder_begin_callback)(struct parakeet_context * ctx, struct parakeet_state * state, void * user_data);
 
+    // Logits filter callback
+    // Called after the joint network, before the greedy choice of the next token.
+    // logits holds n_logits token logits (the blank token last) and may be modified.
+    typedef void (*parakeet_logits_filter_callback)(
+            struct parakeet_context * ctx,
+              struct parakeet_state * state,
+                              float * logits,
+                                int   n_logits,
+                               void * user_data);
+
     // Parameters for the parakeet_full() function
     // If you change the order or add new parameters, make sure to update the default values in parakeet.cpp:
     // parakeet_full_default_params()
@@ -264,6 +274,10 @@ extern "C" {
         // called each time before ggml computation starts
         ggml_abort_callback abort_callback;
         void * abort_callback_user_data;
+
+        // called by the greedy decoder before each token choice
+        parakeet_logits_filter_callback logits_filter_callback;
+        void * logits_filter_callback_user_data;
     };
 
     // NOTE: this function allocates memory, and it is the responsibility of the caller to free the pointer - see parakeet_free_context_params() & parakeet_free_params()
diff --git a/src/parakeet.cpp b/src/parakeet.cpp
--- a/src/parakeet.cpp
+++ b/src/parakeet.cpp
@@ -2558,6 +2558,11 @@ static bool parakeet_decode(
 
         const int64_t t_start_sample_us = ggml_time_us();
 
+        if (params && params->logits_filter_callback) {
+            params->logits_filter_callback(&pctx, &pstate, pstate.logits.data(), n_vocab_logits,
+                    params->logits_filter_callback_user_data);
+        }
+
         // find the best token (greedy).
         // TODO: implement beam search?
         int best_token = 0;
@@ -3552,6 +3557,8 @@ struct parakeet_full_params parakeet_full_default_params(enum parakeet_sampling_
         /*.encoder_begin_callback_user_data =*/ nullptr,
         /*.abort_callback                   =*/ nullptr,
         /*.abort_callback_user_data         =*/ nullptr,
+        /*.logits_filter_callback           =*/ nullptr,
+        /*.logits_filter_callback_user_data =*/ nullptr,
     };
 
     return result;
