rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedInOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isReasonableTimestamp(value) {
      return value is int
        && value > 1609459200000
        && value < request.time.toMillis() + 300000;
    }

    function isValidUserProfile() {
      return request.resource.data.keys().hasOnly([
          'name',
          'email',
          'workspaceRole',
          'createdAtUtcMs',
          'updatedAtUtcMs'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 80
        && request.resource.data.email is string
        && request.resource.data.email.size() >= 3
        && request.resource.data.email.size() <= 200
        && request.resource.data.workspaceRole is string
        && request.resource.data.workspaceRole.size() >= 1
        && request.resource.data.workspaceRole.size() <= 80
        && isReasonableTimestamp(request.resource.data.createdAtUtcMs)
        && isReasonableTimestamp(request.resource.data.updatedAtUtcMs);
    }

    function isValidRecentSentence() {
      return request.resource.data.keys().hasOnly([
          'text',
          'createdAtUtcMs'
        ])
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 1
        && request.resource.data.text.size() <= 512
        && isReasonableTimestamp(request.resource.data.createdAtUtcMs);
    }

    function isValidDictionaryTerm() {
      return request.resource.data.keys().hasOnly([
          'term',
          'source',
          'normalizedTerm',
          'createdAtUtcMs',
          'updatedAtUtcMs',
          'deletedAtUtcMs'
        ])
        && request.resource.data.term is string
        && request.resource.data.term.size() >= 1
        && request.resource.data.term.size() <= 72
        && request.resource.data.source is string
        && request.resource.data.source.size() >= 1
        && request.resource.data.source.size() <= 40
        && request.resource.data.normalizedTerm is string
        && request.resource.data.normalizedTerm.size() >= 1
        && request.resource.data.normalizedTerm.size() <= 72
        && isReasonableTimestamp(request.resource.data.createdAtUtcMs)
        && isReasonableTimestamp(request.resource.data.updatedAtUtcMs)
        && request.resource.data.updatedAtUtcMs >= request.resource.data.createdAtUtcMs
        && (request.resource.data.deletedAtUtcMs == null
          || (isReasonableTimestamp(request.resource.data.deletedAtUtcMs)
            && request.resource.data.deletedAtUtcMs >= request.resource.data.updatedAtUtcMs));
    }

    // TRANSITIONAL (added for the 0.5.6 rollout, 2026-07-24) — REMOVE LATER.
    //
    // 0.5.6 changed the dictionary record shape: `termNormalized` became
    // `normalizedTerm`, and `updatedAtUtcMs`/`deletedAtUtcMs` became required
    // so that deletes can propagate as tombstones. Those shapes are mutually
    // exclusive under `hasOnly`, so enforcing only the new one would deny
    // dictionary writes from clients still on 0.5.5 or earlier. On those
    // builds a signed-in user's dictionary edits went to Firestore *only*
    // (the split-brain bug 0.5.6 fixes), so a denied write means the term is
    // not saved anywhere.
    //
    // This validator accepts the legacy shape so both versions keep working
    // during rollout. 0.5.6+ clients never write it: `dictionarySync.ts`
    // recomputes identity for legacy rows, writes the deterministic record,
    // and then deletes the legacy document.
    //
    // Removal: once auto-update adoption of 0.5.6+ is effectively complete,
    // delete this function and drop the `|| isLegacyDictionaryTerm()` branch
    // from the /dictionaryTerms rule below. Nothing else depends on it.
    function isLegacyDictionaryTerm() {
      return request.resource.data.keys().hasOnly([
          'term',
          'source',
          'termNormalized',
          'createdAtUtcMs'
        ])
        && request.resource.data.term is string
        && request.resource.data.term.size() >= 1
        && request.resource.data.term.size() <= 72
        && request.resource.data.source is string
        && request.resource.data.source.size() >= 1
        && request.resource.data.source.size() <= 40
        && request.resource.data.termNormalized is string
        && request.resource.data.termNormalized.size() >= 1
        && request.resource.data.termNormalized.size() <= 72
        && isReasonableTimestamp(request.resource.data.createdAtUtcMs);
    }

    function isValidVoiceSnippet() {
      return request.resource.data.keys().hasOnly([
          'trigger',
          'normalizedTrigger',
          'expansion',
          'createdAtUtcMs',
          'updatedAtUtcMs',
          'deletedAtUtcMs'
        ])
        && request.resource.data.trigger is string
        && request.resource.data.trigger.size() >= 1
        && request.resource.data.trigger.size() <= 60
        && request.resource.data.normalizedTrigger is string
        && request.resource.data.normalizedTrigger.size() >= 1
        && request.resource.data.normalizedTrigger.size() <= 60
        && request.resource.data.expansion is string
        && request.resource.data.expansion.size() <= 4000
        && isReasonableTimestamp(request.resource.data.createdAtUtcMs)
        && isReasonableTimestamp(request.resource.data.updatedAtUtcMs)
        && request.resource.data.updatedAtUtcMs >= request.resource.data.createdAtUtcMs
        && ((request.resource.data.deletedAtUtcMs == null
              && request.resource.data.expansion.size() >= 1)
          || (isReasonableTimestamp(request.resource.data.deletedAtUtcMs)
              && request.resource.data.deletedAtUtcMs >= request.resource.data.updatedAtUtcMs
              && request.resource.data.expansion == ''));
    }

    match /users/{userId} {
      allow read: if isSignedInOwner(userId);
      allow create: if isSignedInOwner(userId) && isValidUserProfile();
      allow update: if isSignedInOwner(userId)
        && isValidUserProfile()
        && request.resource.data.createdAtUtcMs == resource.data.createdAtUtcMs;
      allow delete: if isSignedInOwner(userId);

      match /recentSentences/{sentenceId} {
        allow read: if isSignedInOwner(userId);
        allow create, update: if isSignedInOwner(userId) && isValidRecentSentence();
        allow delete: if isSignedInOwner(userId);
      }

      match /dictionaryTerms/{termId} {
        allow read: if isSignedInOwner(userId);
        // The legacy branch is transitional for the 0.5.6 rollout — see the
        // removal note on isLegacyDictionaryTerm() above.
        allow create, update: if isSignedInOwner(userId)
          && (isValidDictionaryTerm() || isLegacyDictionaryTerm());
        allow delete: if isSignedInOwner(userId);
      }

      match /voiceSnippets/{snippetId} {
        allow read: if isSignedInOwner(userId);
        allow create, update: if isSignedInOwner(userId) && isValidVoiceSnippet();
        allow delete: if isSignedInOwner(userId);
      }
    }
  }
}
