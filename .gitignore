node_modules/
dist/
*.tsbuildinfo
.DS_Store
Thumbs.db
.env
.env.*
!.env.example
*.log
firebase-debug.log
coverage/
src-tauri/coverage/

# Tauri / Rust
src-tauri/target/
# Cargo.lock is intentionally committed: this is a binary/app, so we want
# reproducible CI builds (a fresh resolve once pulled a broken transitive
# brotli-decompressor and failed the release build).

# Tauri updater signing keys — NEVER commit the private key.
# Only the .pub half is safe; it already lives in tauri.conf.json as `pubkey`.
src-tauri/.tauri/

# Alternate Rust build targets (phase 3 staging, etc.)
.phase3-target/
.phase3-target-*/

# Python
__pycache__/
*.pyc
.venv/
.venv-*/

# IDE / editor
.vscode/

# Agent / AI tooling (local scratch)
.claude/
.superpowers/

# Local temp / diagnostic scratch files
tmp-*

# Local app data
.voicewave/
timeline-demo.mp4

# Bundled faster-whisper CPU runtime (~400 MB): built on demand by
# scripts/faster_whisper/build-embedded-runtime.ps1 for local/CI installer
# builds, never committed. The .gitkeep placeholder IS tracked so the
# directory exists — tauri-build validates the bundle.resources path at
# compile time, so plain `cargo check`/`cargo test` (which don't stage the
# runtime) would otherwise fail with "resource path doesn't exist".
src-tauri/windows/faster-whisper/python/*
!src-tauri/windows/faster-whisper/python/.gitkeep

# LLM polish (on-device AI polish) artifacts.
# The GGUF models are ~1-2 GB each and are downloaded on demand to the app data
# dir, never committed. Spike outputs and byte-caches are dead weight.
scripts/llm-polish/models/
scripts/llm-polish/results/
scripts/llm-polish/**/__pycache__/
src-tauri/windows/llm-polish/__pycache__/
# In wheelhouse, commit ONLY the prebuilt AVX2 llama-cpp-python wheel (needed by
# the runtime build so a fresh install can run AI polish on any AVX2 CPU); the
# small pure-Python deps come from PyPI at build time.
scripts/llm-polish/wheelhouse/*
!scripts/llm-polish/wheelhouse/llama_cpp_python-*-win_amd64.whl
